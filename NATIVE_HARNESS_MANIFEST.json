{
  "version": "4.1.0",
  "canonical_skills": 5,
  "manual_workflows": 4,
  "semantic_skills": [
    "my-software-design-doc"
  ],
  "runtime_state": {
    "root": "./.agents/tmp/",
    "implementation": "./.agents/tmp/implementation/<slug>.md"
  },
  "skill_routing": "Claude Code native skill discovery; no generated registry",
  "profiles": {
    "claude-code": {
      "root": "dist/skills",
      "install_destinations": {
        "project": "<target>/.claude/skills",
        "global": "~/.claude/skills (or $CLAUDE_CONFIG_DIR/skills)"
      },
      "native_features": [
        "disable-model-invocation",
        "user-invocable",
        "argument-hint",
        "$ARGUMENTS"
      ]
    }
  },
  "installer": {
    "entrypoint": "bin/software-skills.js",
    "repository": "https://github.com/cceglia/software-skills",
    "interactive_prompts": [
      "install scope (project or global)"
    ],
    "cli_options": [
      "--scope",
      "--target",
      "--force",
      "--dry-run",
      "--git-exclude",
      "--help",
      "--version"
    ],
    "install_command": "npx --yes github:cceglia/software-skills#claude"
  },
  "external_dependencies": {
    "my-grill-to-implementation": [
      "mattpocock/skills:grill-with-docs",
      "mattpocock/skills:grilling",
      "mattpocock/skills:domain-modeling",
      "mattpocock/skills:tdd"
    ]
  },
  "subagents": "skills never name a subagent type; Claude Code chooses autonomously; no custom agents installed",
  "removed_workflows": {
    "replaced_by": "Matt Pocock skills used directly",
    "skills": [
      "my-git-commit",
      "my-grill-to-spec",
      "my-implement-orchestrator",
      "my-review-changes",
      "my-spec-to-tickets"
    ]
  }
}
